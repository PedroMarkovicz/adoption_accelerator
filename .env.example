# ==============================================================================
# Environment Configuration - Example
# ==============================================================================
# Renaming instructions:
# Copy this file to `.env` and fill in the missing secrets to run the application.
# `cp .env.example .env`
# ==============================================================================

# ------------------------------------------------------------------------------
# API Keys & LLM Configuration
# ------------------------------------------------------------------------------
# Required for agent interactions. Get your key at https://platform.openai.com
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY"

# ------------------------------------------------------------------------------
# Observability & Tracing (LangSmith)
# ------------------------------------------------------------------------------
# Recommended for production or heavy dev to trace LangGraph agents.
# Set LANGCHAIN_TRACING_V2 to 'true' to enable tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY="lsv2_YOUR_LANGCHAIN_API_KEY"
LANGCHAIN_PROJECT="adoption_accelerator_poc"

# ------------------------------------------------------------------------------
# Kaggle Configuration
# ------------------------------------------------------------------------------
# Required for downloading the dataset in notebooks (e.g. 00_project_setup.ipynb)
# Find these in your kaggle.json file or at https://www.kaggle.com/settings
KAGGLE_USERNAME="your_kaggle_username"
KAGGLE_API_TOKEN="your_kaggle_api_token"

# ------------------------------------------------------------------------------
# FastAPI Backend Configuration
# ------------------------------------------------------------------------------
# Define the host and port for the FastAPI server (uvicorn).
# Defaults match app/api/main.py expectations.
API_HOST="0.0.0.0"
API_PORT=8000

# ------------------------------------------------------------------------------
# Streamlit Frontend Configuration
# ------------------------------------------------------------------------------
# Typically runs on port 8501. Backend URL points to the FastAPI service.
STREAMLIT_SERVER_PORT=8501
BACKEND_API_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# Logging & Debugging
# ------------------------------------------------------------------------------
# Set logging strictness (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# Langfuse observability (optional - system runs untraced without these)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
